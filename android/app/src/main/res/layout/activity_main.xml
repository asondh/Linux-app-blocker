<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AppBlocker monitor" android:textSize="22sp" android:textStyle="bold"
            android:paddingBottom="12dp" />

        <EditText android:id="@+id/child" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Child's name (e.g. timmy)"
            android:inputType="text" />
        <EditText android:id="@+id/repo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Dashboard repo (owner/name)"
            android:inputType="text" />
        <EditText android:id="@+id/token" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="GitHub token"
            android:inputType="textPassword" />
        <EditText android:id="@+id/branch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Branch (default main)"
            android:inputType="text" />

        <Button android:id="@+id/save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Save settings"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/enableA11y" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="1 · Enable Accessibility" />
        <Button android:id="@+id/usage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="2 · Grant Usage Access" />
        <Button android:id="@+id/battery" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="3 · Ignore battery optimization" />
        <Button android:id="@+id/test" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="4 · Test upload" />

        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:textIsSelectable="true" android:text="" />
    </LinearLayout>
</ScrollView>
